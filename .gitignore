!data/parsed/metadata_review.csv

# local evaluation (added by localeval_commit.sh): results and figures in, caches out
!results/local_eval/
!results/local_eval/per_item/
!results/local_eval/per_item/*.jsonl
results/local_eval/judge_cache/
results/local_eval/.done/
results/local_eval/*.tmp
!results/paper_pack/
!results/paper_pack/figures/
!results/paper_pack/tables/
!data/eval_keyfacts/
!data/eval_keyfacts/*.jsonl

# seed replication: adapters stay local, summaries are committed
models_seeds*/
results/seed_replication/.done/
results/.gpu_pause

# trained_eval (added by git_local_commit.sh): metrics in, answers/caches/quantized models out
!results/trained_eval/
!results/trained_eval/per_item/
!results/trained_eval/per_item/*.jsonl
results/trained_eval/.done/
results/trained_eval/answers/
results/trained_eval/raw/
results/trained_eval/cache/
models_quant/

# cpt (added by git_local_commit.sh): summaries + per-item results in; answers, caches, corpus, adapters out
!results/cpt/
!results/cpt/per_item/
!results/cpt/per_item/*.jsonl
results/cpt/.done/
results/cpt/answers/
results/cpt/raw/
results/cpt/cache/
models_cpt*/
data/cpt*/

# regen (added by git_local_commit.sh): per-item results in; answers, raw output, caches, dequantized bases out
!results/regen/
!results/regen/per_item/
!results/regen/per_item/*.jsonl
results/regen/.done/
results/regen/answers/
results/regen/raw/
results/regen/cache/
models_dequant/
