
# --- secrets, environments, data, weights (added before first push) ---
*.bin
*.pt
*.pyc
*.safetensors
*.zip
.env
.pytest_cache/
.venv-*/
.venv-vllm/
.venv/
__pycache__/
eval/
logs/
logs/*.log
logs/*.out
logs/llm_usage.jsonl
models/
models_epochs*/
